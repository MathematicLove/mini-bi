# Copy to .env and fill in. .env is ignored by git.

# Meta catalog database and API
META_DB_NAME=meta
META_DB_USER=meta_user
META_DB_PASSWORD=change_me
META_DB_PORT=5437
META_API_PORT=8005
META_API_URL=http://localhost:8005

# Templates database and API
TEMPLATES_DB_NAME=templates
TEMPLATES_DB_USER=templates_user
TEMPLATES_DB_PASSWORD=change_me
TEMPLATES_DB_PORT=5436
TEMPLATES_API_PORT=8004
TEMPLATES_API_URL=http://localhost:8004

# Streamlit app
APP_PORT=8501

# Source databases: list of ids, then one agent URL per id
SOURCES=extra_for_students,mountain_sport,sport_and_cheerleaders
SOURCE_EXTRA_FOR_STUDENTS_URL=http://localhost:8006
SOURCE_MOUNTAIN_SPORT_URL=http://localhost:8007
SOURCE_SPORT_AND_CHEERLEADERS_URL=http://localhost:8008
